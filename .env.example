# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a Git.

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5432/Db-Med
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT: secreto aleatorio de al menos 32 caracteres (generar con: openssl rand -base64 48) ---
JWT_SECRET=

# --- Primer ADMIN: se crea al arrancar solo si no existe ninguno. Debe cambiar la contraseña al ingresar ---
ADMIN_INICIAL_USERNAME=admin
ADMIN_INICIAL_PASSWORD=

# --- Solo para la nube (ver docs/manual-despliegue.md); en local no hace falta definirlas ---
# ALMACENAMIENTO_TIPO=bd          (los documentos se guardan en PostgreSQL)
# COOKIE_SECURE=true              (la cookie de sesión solo viaja por HTTPS)
# FORWARD_HEADERS=framework       (IP real del usuario detrás del proxy)
# CORS_ORIGENES=https://su-app.vercel.app
# TURNSTILE_SECRET=               (CAPTCHA tras 3 intentos fallidos; en local se puede usar la clave de prueba de
#                                 Cloudflare 1x0000000000000000000000000000000AA, que siempre aprueba)

# --- Cifrado de datos sensibles del paciente: 32 bytes aleatorios en Base64 ---
# Generar con (Git Bash): openssl rand -base64 32
# ¡Guarde una copia segura! Si se pierde, esos datos no se pueden descifrar.
CIFRADO_CLAVE=
